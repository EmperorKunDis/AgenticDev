#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════
#  agenticdev — spouštěč pracovního prostředí
#
#  Běží NA VPS, ne na notebooku (ADR-0005). Člověk se přihlásí přes
#  Tailscale SSH, pustí tohle, vybere projekt a pracuje. Na jeho stroji
#  není potřeba Docker.
#
#  Dvojklik na ikonu → vyber projekt → zvol Claude Code nebo Codex.
#  VPS pošle subagenty, hooky, oprávnění a kontext podle fáze.
#
#  Co je čí (ADR-0007):
#    prostředí — skills, hooky, nastavení — posílá server do projektu
#    ~/.claude nebo ~/.codex — osobní subscription session
# ═══════════════════════════════════════════════════════════════
set -euo pipefail

CFG_DIR="${AGENTICDEV_HOME:-$HOME/.agenticdev}"
CFG="$CFG_DIR/config"
WORK_ROOT="${AGENTICDEV_WORK_ROOT:-$HOME/AgenticDev}"
B='\033[1;36m'; G='\033[1;32m'; Y='\033[1;33m'; R='\033[1;31m'; D='\033[2m'; O='\033[0m'
c()    { printf "${B}▸ %s${O}\n" "$*"; }
ok()   { printf "${G}✓ %s${O}\n" "$*"; }
warn() { printf "${Y}! %s${O}\n" "$*"; }
die()  { printf "${R}✗ %s${O}\n" "$*" >&2; exit 1; }

login() {
  . "$CFG" 2>/dev/null || die "Tenhle účet není připojený.\n   Správce ho založí na VPS:  agenticdev-ctl user add '$(id -un)'"
  local challenge cid nonce signature r keyf="$CFG_DIR/device.key"
  [[ -r "$keyf" ]] || die "Chybí soukromý device key; spusť onboarding znovu."
  challenge=$(curl -fsS -X POST "$CONTROL_PLANE/v1/auth/device/challenge" \
        -H 'content-type: application/json' \
        -d "$(jq -nc --arg h "$HOSTNAME_" --arg f "$DEVICE_KEY_FP" \
              '{hostname:$h, device_key_fp:$f}')") \
    || die "Přihlášení selhalo. Jsi na tailnetu? Zkus: tailscale status"
  cid=$(jq -r .challenge_id <<<"$challenge"); nonce=$(jq -r .nonce <<<"$challenge")
  signature=$(python3 - "$keyf" "$nonce" <<'PY'
import base64,sys
from cryptography.hazmat.primitives import serialization
key=serialization.load_ssh_private_key(open(sys.argv[1],'rb').read(),password=None)
print(base64.b64encode(key.sign(sys.argv[2].encode())).decode())
PY
  ) || die "Device challenge se nepodařilo podepsat."
  r=$(curl -fsS -X POST "$CONTROL_PLANE/v1/auth/device" \
        -H 'content-type: application/json' \
        -d "$(jq -nc --arg c "$cid" --arg s "$signature" '{challenge_id:$c,signature:$s}')") \
    || die "Server odmítl proof-of-possession device klíče."
  echo "$r" | jq -r .token > "$CFG_DIR/token"
  chmod 600 "$CFG_DIR/token"
}

get_token() {
  [[ -f "$CFG_DIR/token" ]] || login
  local t; t=$(cat "$CFG_DIR/token")
  if ! curl -fsS -o /dev/null "$CONTROL_PLANE/v1/workspace/projects" \
        -H "Authorization: Bearer $t" 2>/dev/null; then
    login; t=$(cat "$CFG_DIR/token")
  fi
  printf '%s' "$t"
}

cmd_work() {
  . "$CFG" 2>/dev/null || die "Tenhle účet není připojený.\n   Správce ho založí na VPS:  agenticdev-ctl user add '$(id -un)'"

  # --phase <fáze> = pracuj v jiné fázi, aniž bys ji přepínal celému týmu
  local override=""
  local args=(); while [[ $# -gt 0 ]]; do
    case "$1" in
      --phase|-f) override="$2"; shift 2 ;;
      *) args+=("$1"); shift ;;
    esac
  done
  set -- "${args[@]+"${args[@]}"}"
  local t; t=$(get_token)

  local resp n
  resp=$(curl -fsS "$CONTROL_PLANE/v1/workspace/projects" -H "Authorization: Bearer $t")
  n=$(echo "$resp" | jq '.projects | length')
  if [[ "$n" -eq 0 ]]; then
    warn "Zatím žádný projekt."
    echo "  Založ ho v nástěnce: $CONTROL_PLANE"
    read -rp "  Enter zavře okno." _; exit 0
  fi

  local code="${1:-}"
  if [[ -z "$code" ]]; then
    if command -v fzf >/dev/null; then
      code=$(echo "$resp" | jq -r '.projects[] |
              "\(.code)\t\(.client_name // "")\t\(.phase // "-")\t\(.ready_tasks) úkolů"' \
            | column -t -s$'\t' \
            | fzf --height=40% --reverse --border=rounded --prompt='projekt › ' \
                  --header=$'\n  Šipky vybírají, psaním filtruješ, Enter potvrdí\n' \
                  --color='border:8,header:8,prompt:6,pointer:2,hl:2,hl+:2' \
            | awk '{print $1}')
      [[ -n "$code" ]] || { echo "  zrušeno"; exit 0; }
    else
      echo
      printf "  ${B}Na čem chceš dělat?${O}\n\n"
      echo "$resp" | jq -r '.projects | to_entries[] |
        "\(.key+1)|\(.value.code)|\(.value.client_name // "")|\(.value.phase // "-")|\(.value.ready_tasks)"' \
        | while IFS='|' read -r i cd cl ph rt; do
            printf "  %s)  %-18s ${D}%-22s${O} %-15s ${D}%s úkolů${O}\n" "$i" "$cd" "$cl" "$ph" "$rt"
          done
      echo
      local pick; read -rp "  číslo (Enter = 1): " pick </dev/tty
      pick=${pick:-1}
      code=$(echo "$resp" | jq -r ".projects[$((pick-1))].code // empty")
      [[ -n "$code" ]] || die "Neplatná volba."
    fi
  fi

  printf "\n  ${B}Který osobní subscription účet použít?${O}\n\n"
  printf "  1) Claude Code\n  2) Codex\n\n"
  local provider_pick provider
  read -rp "  číslo (Enter = 1): " provider_pick </dev/tty
  case "${provider_pick:-1}" in 1) provider=claude ;; 2) provider=codex ;; *) die "Neplatný provider." ;; esac
  if [[ "$provider" == claude ]]; then
    command -v claude >/dev/null || die "Claude Code CLI na VPS chybí."
    claude auth status >/dev/null 2>&1 || claude
    claude auth status >/dev/null 2>&1 || die "AUTH_REQUIRED: přihlášení Claude není platné."
  else
    command -v codex >/dev/null || die "Codex CLI na VPS chybí."
    # Práce běží na vzdáleném VPS. Výchozí OAuth callback poslouchá na
    # localhostu VPS a prohlížeč uživatele se k němu nedostane; device flow
    # je určený pro SSH/headless prostředí.
    codex login status >/dev/null 2>&1 || codex login --device-auth
    codex login status >/dev/null 2>&1 || die "AUTH_REQUIRED: přihlášení Codex není platné."
  fi
  curl -fsS -X POST "$CONTROL_PLANE/v1/provider-profile" \
    -H "Authorization: Bearer $t" -H 'content-type: application/json' \
    -d "$(jq -nc --arg p "$provider" '{provider:$p,auth_status:"ready"}')" >/dev/null \
    || die "Stav provider loginu se nepodařilo zapsat."

  echo; c "Stahuji nastavení pro $code"
  local b
  b=$(curl -fsS "$CONTROL_PLANE/v1/workspace/$code/bundle${override:+?phase=$override}" \
        -H "Authorization: Bearer $t") || die "Projekt '$code' se nepodařilo načíst."

  local repo phase client dclass tasks ws
  repo=$(echo "$b"   | jq -r .project.repo_url)
  phase=$(echo "$b"  | jq -r .project.phase)
  client=$(echo "$b" | jq -r '.project.client // ""')
  dclass=$(echo "$b" | jq -r .project.data_class)
  tasks=$(echo "$b"  | jq -r .ready_tasks)
  ws="$WORK_ROOT/$code"

  local analysis_status
  analysis_status=$(echo "$b" | jq -r '.project.analysis_status // "awaiting_provider"')
  if [[ "$analysis_status" != ready ]]; then
    command -v agenticdev-broker-client >/dev/null \
      || die "Chybí klient privilegovaného brokeru; kontaktuj správce."
    c "Spouštím read-only analýzu repozitáře ($analysis_status)"
    curl -fsS -X POST "$CONTROL_PLANE/v1/projects/$code/analysis/retry" \
      -H "Authorization: Bearer $t" -H 'content-type: application/json' \
      -d "$(jq -nc --arg p "$provider" '{provider:$p}')" >/dev/null \
      || die "Analýzu se nepodařilo zařadit."
    local awo aid astarted
    awo=$(curl -fsS "$CONTROL_PLANE/v1/work-orders/next?project=$code&provider=$provider&analysis=true" \
      -H "Authorization: Bearer $t") || die "Server nevydal podepsaný analysis Work Order."
    jq -e '.work_order.signature and (.work_order.runtime.mode == "analysis")' >/dev/null <<<"$awo" \
      || die "Neplatný analysis Work Order."
    astarted=$(AGENTICDEV_DEVICE_TOKEN="$t" agenticdev-broker-client start \
      <<<"$(jq -c '.work_order' <<<"$awo")") || die "Broker analýzu odmítl."
    aid=$(jq -r .work_order_id <<<"$astarted")
    AGENTICDEV_DEVICE_TOKEN="$t" agenticdev-broker-client attach "$aid" \
      || die "Analýza byla přerušena."
    AGENTICDEV_DEVICE_TOKEN="$t" agenticdev-broker-client stop "$aid" >/dev/null || true
    analysis_status=$(curl -fsS "$CONTROL_PLANE/v1/projects/$code/analysis" \
      -H "Authorization: Bearer $t" | jq -r .state)
    local analysis_json answers='{}' count question answer
    analysis_json=$(curl -fsS "$CONTROL_PLANE/v1/projects/$code/analysis" -H "Authorization: Bearer $t")
    case "$analysis_status" in
      failed)
        die "Analýza selhala / Analysis failed: $(jq -r '.error // "neznámá chyba / unknown error"' <<<"$analysis_json")" ;;
      analyzing|awaiting_provider)
        die "Analýza nedodala výsledek / Analysis produced no result (stav/state '$analysis_status'). Zkontroluj transkript / Check the transcript." ;;
      questions|review) ;;
      *) die "Analýza skončila v neočekávaném stavu / Analysis ended in unexpected state '$analysis_status'." ;;
    esac
    if [[ "$analysis_status" == questions ]]; then
      count=$(jq '.questions|length' <<<"$analysis_json")
      for ((i=0;i<count;i++)); do
        question=$(jq -r ".questions[$i].question // .questions[$i]" <<<"$analysis_json")
        printf "\n  ${B}%s${O}\n" "$question"
        read -r -p "  odpověď: " answer </dev/tty
        answers=$(jq -c --arg k "$i" --arg v "$answer" '. + {($k):$v}' <<<"$answers")
      done
      curl -fsS -X POST "$CONTROL_PLANE/v1/projects/$code/analysis/answers" \
        -H "Authorization: Bearer $t" -H 'content-type: application/json' \
        -d "$(jq -nc --argjson a "$answers" '{answers:$a}')" >/dev/null \
        || die "Odpovědi se nepodařilo uložit."
      analysis_json=$(curl -fsS "$CONTROL_PLANE/v1/projects/$code/analysis" -H "Authorization: Bearer $t")
    fi
    local review_file
    review_file=$(mktemp); jq '.result' <<<"$analysis_json" >"$review_file"
    printf "\n  Otevírám výsledek analýzy k lidské revizi. Ulož a zavři editor.\n"
    "${EDITOR:-nano}" "$review_file" </dev/tty >/dev/tty
    jq -e 'type=="object"' "$review_file" >/dev/null || die "Výsledek musí zůstat JSON objekt."
    curl -fsS -X POST "$CONTROL_PLANE/v1/projects/$code/analysis/revise" \
      -H "Authorization: Bearer $t" -H 'content-type: application/json' \
      -d "$(jq -nc --slurpfile r "$review_file" '{result:$r[0],questions:[]}')" >/dev/null \
      || die "Upravená analýza neprošla schema/citation validací."
    rm -f "$review_file"
    read -r -p "  Schválit analýzu a odemknout mutující úkoly? [y/N] " answer </dev/tty
    [[ "$answer" =~ ^[yYaA]$ ]] || { warn "Analýza zůstává v review; úkoly jsou zamčené."; return 0; }
    curl -fsS -X POST "$CONTROL_PLANE/v1/projects/$code/analysis/approve" \
      -H "Authorization: Bearer $t" >/dev/null || die "Schválení selhalo."
    ok "analýza schválena; mutující Work Ordery jsou odemčené"
    b=$(curl -fsS "$CONTROL_PLANE/v1/workspace/$code/bundle${override:+?phase=$override}" \
      -H "Authorization: Bearer $t") || die "Schválený bundle nelze načíst."
  fi

  mkdir -p "$WORK_ROOT"
  if [[ -d "$ws/.git" ]]; then
    c "Aktualizuji repozitář"
    git -C "$ws" fetch --quiet --all 2>/dev/null || warn "fetch se nepovedl, pokračuji"
  else
    c "Klonuji $repo"
    git clone --quiet "$repo" "$ws" 2>/dev/null || { mkdir -p "$ws"; git -C "$ws" init -q; }
  fi

  # Git po síti dělá hostitel, ne pod. Agent tak nikdy nedrží přihlašovací
  # údaje k repozitáři — commituje lokálně, push proběhne po skončení.
  local branch="agenticdev/$(date +%Y%m%d-%H%M%S)"
  git -C "$ws" checkout -q -B "$branch" 2>/dev/null || true

  c "Nastavuji pracovní prostředí"
  echo "$b" | jq -r '.files | to_entries[] | @base64' | while read -r row; do
    dec=$(echo "$row" | base64 --decode)
    path=$(echo "$dec" | jq -r .key)
    mkdir -p "$ws/$(dirname "$path")"
    echo "$dec" | jq -r .value > "$ws/$path"
  done
  chmod +x "$ws"/bin/* 2>/dev/null || true

  mkdir -p "$ws/.agenticdev/bin"
  cat > "$ws/.agenticdev/bin/agenticdev-decision" <<DEC
#!/usr/bin/env bash
curl -fsS -X POST "$CONTROL_PLANE/v1/workspace/$code/decision" \\
  -H "Authorization: Bearer \$(cat /run/agenticdev/token 2>/dev/null)" \\
  -H 'content-type: application/json' \\
  -d "\$(jq -nc --arg q "\$1" --arg ch "\$2" --arg r "\$3" \\
        '{question:\$q, chosen:\$ch, rationale:\$r}')" >/dev/null \\
  && echo "✓ zapsáno na VPS" || echo "✗ zápis selhal"
DEC
  chmod +x "$ws/.agenticdev/bin/agenticdev-decision"
  grep -q '^\.agenticdev/$' "$ws/.gitignore" 2>/dev/null || echo '.agenticdev/' >> "$ws/.gitignore"

  # ── Privilegovaný broker ──────────────────────────────────────
  # Klient neposílá Compose, image, command, environment, mount ani host path.
  # Jediným autoritativním vstupem je přesně podepsaný Work Order; všechny
  # runtime detaily skládá root-owned broker z immutable šablony.
  local wo wo_id
  wo=$(curl -fsS "$CONTROL_PLANE/v1/work-orders/next?project=$code&provider=$provider" \
       -H "Authorization: Bearer $t") \
    || die "Server nevydal Work Order. Bez ověřitelné autorizace pod nespustím."
  jq -e '.work_order.signature and .work_order.nonce' >/dev/null <<<"$wo" \
    || die "Server nevydal podepsaný Work Order. Interaktivní fallback je zakázán."
  wo_id=$(jq -r '.work_order.work_order_id' <<<"$wo")
  c "Work Order $(cut -c1-8 <<<"$wo_id") — $(jq -r '.work_order.task.title' <<<"$wo")"

  command -v agenticdev-broker-client >/dev/null \
    || die "Chybí klient privilegovaného brokeru; kontaktuj správce."
  c "Startuji pod přes privilegovaný broker"
  local started broker_reason
  if ! started=$(AGENTICDEV_DEVICE_TOKEN="$t" agenticdev-broker-client start \
      <<<"$(jq -c '.work_order' <<<"$wo")"); then
    broker_reason=$(jq -r '.reason // "neznámý důvod / unknown reason"' <<<"$started" 2>/dev/null \
      || printf '%s' "neznámý důvod / unknown reason")
    die "Broker workload odmítl / Broker rejected workload: $broker_reason"
  fi
  wo_id=$(jq -r '.work_order_id' <<<"$started")
  AGENTICDEV_DEVICE_TOKEN="$t" agenticdev-broker-client attach "$wo_id" \
    || die "Attach selhal nebo byl workload revokován."
  AGENTICDEV_DEVICE_TOKEN="$t" agenticdev-broker-client stop "$wo_id" >/dev/null \
    || warn "Broker workload bezpečně neukončil; kontaktuj správce."

  # Broker vlastní lifecycle, teardown i audit. Klient nemá container ID ani
  # oprávnění volat runtime přímo.

  if [[ -n "$(git -C "$ws" status --porcelain 2>/dev/null)" ]]; then
    warn "Ve workspace zůstaly nezacommitované změny."
  fi
  if git -C "$ws" rev-parse --verify -q "$branch" >/dev/null 2>&1; then
    if git -C "$ws" log --oneline "origin/$branch..$branch" 2>/dev/null | grep -q .; then
      c "Odesílám větev $branch"
      git -C "$ws" push -q -u origin "$branch" 2>/dev/null \
        && ok "odesláno" || warn "push se nepovedl — zkus ručně: git -C $ws push -u origin $branch"
    fi
  fi

  # Výsledek od directora. Co rozhodly kontroly projektu, ne agent.
  local outcome_status=0
  if [[ -n "${wo_id:-}" ]]; then
    local outcome="aborted"
    [[ -f "$ws/.agenticdev/outcome" ]] && outcome=$(tr -d '\n' < "$ws/.agenticdev/outcome")
    case "$outcome" in
      done|review) ok "postup dojel: $outcome" ;;
      blocked)     warn "úkol jde do blocked — kontroly po limitu pořád padaly"; outcome_status=1 ;;
      *)           warn "postup nedojel do konce ($outcome)"; outcome_status=1 ;;
    esac
    # 'review' i 'done' znamenají pro control plane jedno: práce je na
    # člověku. Stav done nastaví až merge PR (ADR-0006).
    local rel="done"; [[ "$outcome" == "blocked" ]] && rel="blocked"
    [[ "$outcome" == "aborted" ]] && rel="aborted"
    curl -fsS -X POST "$CONTROL_PLANE/v1/work-orders/$wo_id/release?outcome=$rel" \
      -H "Authorization: Bearer $t" >/dev/null 2>&1 \
      || warn "release work orderu se nepovedl"
    rm -f "$ws/.agenticdev/outcome"
  fi

  # Agent dokončil úkol přes `agenticdev-git finish`. Ten nepushuje ani
  # neotevírá PR — nemá k repozitáři přístup a token do Forgeja mu dát
  # nechceme. Doděláme to tady, na hostiteli, kde klíč i token patří.
  finish_task "$ws" "$t"
  return "$outcome_status"
}

# Odeslání dokončené větve a založení PR. Hledá vzkaz, který v podu nechal
# `agenticdev-git finish`.
finish_task() {
  local ws="$1" t="$2" f
  for f in "$ws/.agenticdev/finished" "$ws"/../.agenticdev-trees/*/.agenticdev/finished; do
    [[ -f "$f" ]] || continue
    local wt br base title tid body
    wt=$(cd "$(dirname "$f")/.." && pwd)
    br=$(jq -r '.branch // ""' "$f")
    base=$(jq -r '.base // "main"' "$f")
    title=$(jq -r '.title // ""' "$f")
    tid=$(jq -r '.task_id // ""' "$f")
    body=$(jq -r '.body // ""' "$f")
    [[ -n "$br" ]] || { rm -f "$f"; continue; }

    c "Odesílám dokončenou větev $br"
    if ! git -C "$wt" push -q -u origin "$br" --force-with-lease 2>/dev/null; then
      warn "push $br se nepovedl — vzkaz nechávám, zkusí se příště"
      continue
    fi
    git -C "$wt" push -q origin refs/notes/agenticdev 2>/dev/null || true
    ok "odesláno"

    if [[ -z "$tid" ]]; then
      warn "ve vzkazu není task_id — PR otevři ručně"
      rm -f "$f"; continue
    fi
    local r
    r=$(curl -fsS -X POST "$CONTROL_PLANE/v1/tasks/$tid/pull-request" \
          -H "Authorization: Bearer $t" -H 'content-type: application/json' \
          -d "$(jq -nc --arg b "$br" --arg ba "$base" --arg ti "$title" --arg bo "$body" \
                '{task_id:"", branch:$b, base:$ba, title:$ti, body:$bo}')" 2>/dev/null) \
      && ok "PR: $(jq -r '.url // .note // "otevřen"' <<<"$r")" \
      || warn "PR se nepodařilo otevřít — zkus to z panelu"
    rm -f "$f"
  done
}

cmd_doctor() {
  local bad=0
  for t in git jq curl; do
    command -v $t >/dev/null && ok "$t" || { warn "chybí: $t"; bad=1; }
  done
  command -v agenticdev-broker-client >/dev/null && ok "privilegovaný broker" || { warn "broker klient chybí"; bad=1; }
  ok "Claude/Codex přihlášení je oddělené per Unix UID"
  command -v tailscale >/dev/null && ok "tailscale" || warn "tailscale"
  if [[ -f "$CFG" ]]; then
    ok "konfigurace"
    . "$CFG"
    curl -fsS --max-time 5 "$CONTROL_PLANE/v1/health" >/dev/null 2>&1 \
      && ok "spojení s VPS" || { warn "VPS nedostupný: $CONTROL_PLANE"; bad=1; }
  else
    warn "nepřipojeno — správce spustí: agenticdev-ctl user add $(id -un)"; bad=1
  fi
  [[ $bad -eq 0 ]] && ok "Všechno v pořádku." || die "Oprav výše uvedené."
}

case "${1:-work}" in
  work)   shift 2>/dev/null || true; cmd_work "$@" ;;
  doctor) cmd_doctor ;;
  board)  . "$CFG"; echo "$CONTROL_PLANE" ;;
  login)  login && ok "přihlášeno" ;;
  *) cat <<'HELP'
agenticdev — pracovní prostředí AgenticDev

  agenticdev work [projekt]   vyber projekt a začni pracovat
  agenticdev work X --phase delivery
                         pracuj v jiné fázi, ostatním se nic nemění
  agenticdev doctor           zkontroluje prostředí
  agenticdev board            otevře nástěnku
  agenticdev login            obnoví přihlášení
HELP
  ;;
esac
