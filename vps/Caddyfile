# Caddy se startuje JEN v režimu public (profil "public" v compose), tedy
# když má instance doménu. V režimu tailnet neběží a platforma je vidět
# jen po tailnetu.
#
# CO JE TÍMHLE VIDĚT: pokud je AGENTICDEV_DOMAIN veřejná doména s veřejným
# A záznamem, je tímhle vstupem z internetu dostupný celý control plane
# včetně admin panelu — chráněný jedním heslem. To je vědomý kompromis
# režimu public, ne nedopatření; panel má omezení pokusů, ale heslo je
# heslo. Kdo to nechce, nechá doménu prázdnou a jede po tailnetu, kde je
# zvenčí publikovaná jen registrace přes Funnel.
#
# U domény *.ts.net je to jinak: takovou doménu veřejné DNS nepřeloží,
# takže sem stejně dosáhne jen tailnet.
{
	email {$SMTP_FROM}
}

{$AGENTICDEV_DOMAIN} {
	# Tailnet doména nemá veřejný DNS záznam — Let's Encrypt ji nikdy
	# neověří. Certifikát vydá sám Tailscale přes tailscaled.sock.
	tls {
		get_certificate tailscale
	}

	encode zstd gzip

	# X-Forwarded-For doplňuje reverse_proxy sám a control plane na něm
	# staví omezení pokusů o heslo. Nepřepisovat: kdyby sem chodila adresa
	# Caddy místo klientovy, limit by po pěti pokusech zamkl celý svět.

	# Control plane API — pro stanice a pody na tailnetu
	handle /v1/* {
		reverse_proxy control-plane:8080
	}

	# Registrace strojů
	handle /join* {
		reverse_proxy control-plane:8080
	}

	# Forgejo — git, PR, Actions, webhooky
	handle /git/* {
		uri strip_prefix /git
		reverse_proxy forgejo:3000
	}

	# Nástěnka a instalační skripty
	handle {
		reverse_proxy control-plane:8080
	}

	log {
		output file /data/access.log
		format json
	}
}
