[Unit]
Description=AgenticDev privileged runtime broker
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
Group=agenticdev-broker
EnvironmentFile=/srv/agenticdev/config/.env
ExecStart=/usr/local/lib/agenticdev/broker.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/agenticdev /var/lib/agenticdev-broker /var/log /srv/agenticdev/workloads
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0007
Restart=on-failure

[Install]
WantedBy=multi-user.target
