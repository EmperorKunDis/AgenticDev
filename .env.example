# ═══════════════════════════════════════════════════════════════
#  Praut Platform — jediné místo, kde něco vyplňuješ
#  cp .env.example .env  &&  make keys  &&  vyplň zbytek
# ═══════════════════════════════════════════════════════════════

# ─── VPS ───────────────────────────────────────────────────────
PRAUT_DOMAIN=platform.example.com          # doména, na které poběží Caddy
VPS_HOST=100.64.0.1                     # tailnet IP VPS (ne veřejná)
VPS_SSH_USER=root
TZ=Europe/Prague

# ─── Tajemství — VYGENERUJ přes `make keys`, nekopíruj odjinud ──
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
JWT_SECRET=
WO_SIGNING_KEY_B64=                     # ed25519 privátní klíč (control plane)
WO_VERIFY_KEY_B64=                      # ed25519 veřejný klíč (harness)

# ─── Forgejo ───────────────────────────────────────────────────
FORGEJO_ADMIN_USER=admin
FORGEJO_ADMIN_EMAIL=admin@example.com
FORGEJO_ADMIN_PASSWORD=

# ─── Mail (nové schránky) ──────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=platform@example.com

# ─── Modely — na dodavateli nezáleží ──────────────────────────
# MODEL_BACKEND: openai | anthropic | ollama | cli
#   openai = JAKÝKOLI OpenAI-kompatibilní endpoint
#            (OpenAI, Codex, OpenRouter, Groq, DeepSeek, LiteLLM, vLLM…)
#   cli    = agentní CLI jako podproces; agent má skutečné nástroje
MODEL_BACKEND=openai
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
DEFAULT_MODEL=gpt-5.5
MODEL_MAX_TOKENS=8000

# ── Codex přes API ──
# MODEL_BACKEND=openai
# MODEL_BASE_URL=https://api.openai.com/v1
# DEFAULT_MODEL=gpt-5-codex

# ── OpenRouter (jeden klíč, ~všechny modely) ──
# MODEL_BASE_URL=https://openrouter.ai/api/v1
# DEFAULT_MODEL=openai/gpt-5.5

# ── Codex CLI jako agent se skutečnými nástroji ──
# MODEL_BACKEND=cli
# CLI_TEMPLATE=codex exec --model {model} --cd {cwd} {prompt}

# ── lokálně a zdarma ──
# MODEL_BACKEND=ollama
# DEFAULT_MODEL=local/qwen2.5-coder:32b
OLLAMA_HOST=http://host.docker.internal:11434

# ─── Zálohy (restic → B2/Wasabi) ───────────────────────────────
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Verze image (ověř aktuální majory před prvním nasazením) ──
FORGEJO_TAG=11
POSTGRES_TAG=pg16
MINIO_TAG=RELEASE.2025-04-22T22-12-26Z
CADDY_TAG=2-alpine
