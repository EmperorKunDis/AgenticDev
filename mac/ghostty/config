# Praut — konfigurace Ghostty
# Instaluje se do ~/.config/ghostty/config, existující se zálohuje.

font-family = "JetBrains Mono"
font-size = 14
font-feature = calt
font-feature = liga

theme = dark:GruvboxDarkHard,light:GruvboxLight
background-opacity = 0.97
background-blur-radius = 20

window-padding-x = 14
window-padding-y = 10
window-decoration = true
window-title-font-family = ""
macos-titlebar-style = tabs
macos-option-as-alt = true

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = clipboard
scrollback-limit = 100000

# Alt+Enter posílá follow-up v Pi — nesmí přepnout na fullscreen
keybind = alt+enter=text:\x1b\r

confirm-close-surface = false
shell-integration = detect
shell-integration-features = cursor,sudo,title
