#!/usr/bin/env bash
# Spouštěč pro Linux. Ekvivalent AgenticDev.app na macOS: najde terminál,
# otevře ho a spustí v něm `agenticdev work`.
set -euo pipefail

AGENTICDEV=""
for c in /usr/local/bin/agenticdev "$HOME/.local/bin/agenticdev" "$HOME/bin/agenticdev"; do
  [[ -x "$c" ]] && { AGENTICDEV="$c"; break; }
done

if [[ -z "$AGENTICDEV" ]]; then
  msg="AgenticDev není nainstalovaný. Pusť instalaci, kterou ti poslal správce."
  command -v zenity   >/dev/null && exec zenity --error --text="$msg"
  command -v kdialog  >/dev/null && exec kdialog --error "$msg"
  command -v notify-send >/dev/null && exec notify-send "AgenticDev" "$msg"
  echo "$msg" >&2; exit 1
fi

CMD="$AGENTICDEV work"

# Terminály se liší v tom, jak se jim předává příkaz. Bereme první,
# který na stroji je.
for t in ghostty kitty alacritty wezterm gnome-terminal konsole \
         xfce4-terminal tilix x-terminal-emulator xterm; do
  command -v "$t" >/dev/null || continue
  case "$t" in
    ghostty)         exec ghostty --title=AgenticDev -e $CMD ;;
    kitty)           exec kitty --title AgenticDev $CMD ;;
    alacritty)       exec alacritty --title AgenticDev -e $CMD ;;
    wezterm)         exec wezterm start -- $CMD ;;
    gnome-terminal)  exec gnome-terminal --title=AgenticDev -- $CMD ;;
    konsole)         exec konsole -p tabtitle=AgenticDev -e $CMD ;;
    xfce4-terminal)  exec xfce4-terminal --title=AgenticDev -e "$CMD" ;;
    tilix)           exec tilix -t AgenticDev -e $CMD ;;
    *)               exec "$t" -T AgenticDev -e $CMD ;;
  esac
done

echo "Nenašel jsem terminál. Spusť ručně: $CMD" >&2
exit 1
