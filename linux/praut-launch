#!/usr/bin/env bash
# Spouštěč pro Linux. Ekvivalent Praut.app na macOS: najde terminál,
# otevře ho a spustí v něm `praut work`.
set -euo pipefail

PRAUT=""
for c in /usr/local/bin/praut "$HOME/.local/bin/praut" "$HOME/bin/praut"; do
  [[ -x "$c" ]] && { PRAUT="$c"; break; }
done

if [[ -z "$PRAUT" ]]; then
  msg="Praut není nainstalovaný. Pusť instalaci, kterou ti poslal správce."
  command -v zenity   >/dev/null && exec zenity --error --text="$msg"
  command -v kdialog  >/dev/null && exec kdialog --error "$msg"
  command -v notify-send >/dev/null && exec notify-send "Praut" "$msg"
  echo "$msg" >&2; exit 1
fi

CMD="$PRAUT work"

# Terminály se liší v tom, jak se jim předává příkaz. Bereme první,
# který na stroji je.
for t in ghostty kitty alacritty wezterm gnome-terminal konsole \
         xfce4-terminal tilix x-terminal-emulator xterm; do
  command -v "$t" >/dev/null || continue
  case "$t" in
    ghostty)         exec ghostty --title=Praut -e $CMD ;;
    kitty)           exec kitty --title Praut $CMD ;;
    alacritty)       exec alacritty --title Praut -e $CMD ;;
    wezterm)         exec wezterm start -- $CMD ;;
    gnome-terminal)  exec gnome-terminal --title=Praut -- $CMD ;;
    konsole)         exec konsole -p tabtitle=Praut -e $CMD ;;
    xfce4-terminal)  exec xfce4-terminal --title=Praut -e "$CMD" ;;
    tilix)           exec tilix -t Praut -e $CMD ;;
    *)               exec "$t" -T Praut -e $CMD ;;
  esac
done

echo "Nenašel jsem terminál. Spusť ručně: $CMD" >&2
exit 1
